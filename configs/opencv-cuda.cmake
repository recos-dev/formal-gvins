set(WITH_CUDA ON CACHE BOOL "")
set(BUILD_LIST "core,imgproc,imgcodecs,features2d,calib3d,cudev,cudafeatures2d" CACHE STRING "")
set(OPENCV_EXTRA_MODULES_PATH "${CMAKE_CURRENT_LIST_DIR}/../lib/opencv_contrib/modules" CACHE PATH "")
set(WITH_CUBLAS OFF CACHE BOOL "")
set(WITH_CUFFT OFF CACHE BOOL "")
set(WITH_CUDNN OFF CACHE BOOL "")
set(WITH_NVCUVID OFF CACHE BOOL "")
set(WITH_NVCUVENC OFF CACHE BOOL "")
set(CUDA_FAST_MATH OFF CACHE BOOL "")
set(CUDA_NVCC_FLAGS "--std=c++17" CACHE STRING "")
set(CUDA_ARCH_PTX "" CACHE STRING "")
if(NOT CUDA_ARCH_BIN)
    message(FATAL_ERROR "Set CUDA_ARCH_BIN explicitly: 8.6 for RTX 3060; 8.7 for Orin Nano")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/opencv-cpu.cmake")
